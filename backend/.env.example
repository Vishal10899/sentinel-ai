# Application metadata
SENTINEL_AI_PROJECT_TITLE=Sentinel AI
SENTINEL_AI_PROJECT_VERSION=1.0.0
SENTINEL_AI_PROJECT_DESCRIPTION="Sentinel AI API service."

# API and server configuration
SENTINEL_AI_API_V1_PREFIX=/api/v1
SENTINEL_AI_LOG_LEVEL=INFO
SENTINEL_AI_LOG_FORMAT="%(asctime)s | %(levelname)s | %(name)s | %(message)s"

# PostgreSQL connection and pool configuration
SENTINEL_AI_DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@postgres:5432/sentinel_ai
SENTINEL_AI_DATABASE_POOL_SIZE=5
SENTINEL_AI_DATABASE_MAX_OVERFLOW=10

# Redis connection configuration
SENTINEL_AI_REDIS_URL=redis://redis:6379/0

# Provider configuration. Keys are optional because this milestone makes no API calls.
SENTINEL_AI_OPENAI_API_KEY=
SENTINEL_AI_OPENAI_MODEL=gpt-4o-mini
SENTINEL_AI_GEMINI_API_KEY=AQ.Ab8RN6IoWBP8Gy6RljEs4zEoX9QjK2mw-f5YexQiA7-rw9ot1w
SENTINEL_AI_GEMINI_MODEL=gemini-2.0-flash
SENTINEL_AI_OLLAMA_BASE_URL=http://ollama:11434
SENTINEL_AI_OLLAMA_MODEL=llama3.2

# CORS values must be a JSON array when supplied through an environment variable.
SENTINEL_AI_CORS_ORIGINS=["http://localhost:3000"]
SENTINEL_AI_CORS_ALLOW_CREDENTIALS=true
SENTINEL_AI_CORS_ALLOW_METHODS=["*"]
SENTINEL_AI_CORS_ALLOW_HEADERS=["*"]
